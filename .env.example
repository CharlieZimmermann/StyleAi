# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored; this file (.env.example) is the tracked template.
#
# Get both values from the Supabase dashboard:
# Project Settings -> API Keys.
#
# The publishable key is safe to ship inside the app -- it is not a secret.
# Row Level Security (see supabase/schema.sql) is what protects user data.
# Never put the secret key (sb_secret_...) here or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
